# -------------------------------------------------------------
# SERVER-SIDE API KEYS & SECRETS (.env.local)
# -------------------------------------------------------------
# Copy this file to .env.local and fill in your keys.
# These variables are server-side only (used by Next.js API routes).
# ⚠️ Never expose these in the browser — do NOT add NEXT_PUBLIC_ prefix.

# 1. NOTION API KEYS (Required)
# Get yours at: https://www.notion.so/my-integrations -> Create New Integration
NOTION_API_KEY=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_REQUESTS_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_RUN_LOG_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 2. GEMINI AI API KEY (Required for text extraction & classification)
# Get yours at: https://aistudio.google.com/app/apikey (100% Free)
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 3. EMAIL DISPATCH (Required for sending real emails — pick one)
# Option A: Resend API (Recommended - https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Option B: Gmail SMTP (Fallback if Resend is not configured)
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-digit-gmail-app-password
