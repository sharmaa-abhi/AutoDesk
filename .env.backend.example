# -------------------------------------------------------------
# BACKEND API KEYS & SECRETS (.env)
# -------------------------------------------------------------
# ⚠️ Yeh saari keys sirf BACKEND me rahengi, kabhi frontend me mat daalna.

# 1. NOTION API KEYS (Required)
# Kahan se milegi: https://www.notion.so/my-integrations -> Create New Integration
NOTION_API_KEY=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_REQUESTS_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_RUN_LOG_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 2. GEMINI AI API KEY (Required for text extraction & classification)
# Kahan se milegi: https://aistudio.google.com/app/apikey (100% Free)
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 3. EMAIL ACTION API KEY (Required for sending real emails)
# Option A: Resend API (Recommended - https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Option B: Standard Gmail SMTP (Agar Resend use nahi karna)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-digit-gmail-app-password

# 4. SERVER CONFIG
PORT=5000
NODE_ENV=development
