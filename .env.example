# -------------------------------------------------------------
# FRONTEND ONLY ENVIRONMENT VARIABLES (.env / .env.local)
# -------------------------------------------------------------
# NOTE: In Vite, all client-side variables MUST start with `VITE_`
# If using Next.js, use `NEXT_PUBLIC_` instead.

# 1. Backend Engine API URL (Your deployed Node.js/Python server)
VITE_API_BASE_URL=http://localhost:5000/api
# Production example: VITE_API_BASE_URL=https://your-backend-engine.onrender.com/api

# 2. Ingestion Webhook Endpoint (Optional if different from base URL)
VITE_TRIGGER_WEBHOOK_URL=http://localhost:5000/api/v1/trigger

# 3. Application Metadata
VITE_APP_NAME="Notion Lifespan & Request Engine"
VITE_APP_ENV=development

# 4. Optional Public Notion Workspace Link (For frontend iframe / redirect button)
VITE_NOTION_PUBLIC_PAGE_URL=https://notion.so/your-public-workspace-id

# -------------------------------------------------------------
# ⚠️ CRITICAL SECURITY WARNING:
# DO NOT PUT SENSITIVE KEYS HERE (Notion API Key, Gemini Key, SMTP)!
# Frontend variables are public in the browser. All secret keys
# belong in your BACKEND .env only.
# -------------------------------------------------------------
