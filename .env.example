# -------------------------------------------------------------
# FRONTEND ENVIRONMENT VARIABLES (.env / .env.local)
# -------------------------------------------------------------
# NOTE: This is a Next.js 16 (App Router) project.
# Client-side variables MUST start with `NEXT_PUBLIC_`.
# All API routes run on the same server — no separate backend.

# 1. Application Metadata
NEXT_PUBLIC_APP_NAME="AutoDesk Engine"
NEXT_PUBLIC_APP_ENV=development

# 2. Optional Public Notion Workspace Link (For frontend redirect button)
NEXT_PUBLIC_NOTION_PUBLIC_PAGE_URL=https://notion.so/your-public-workspace-id

# -------------------------------------------------------------
# ⚠️ CRITICAL SECURITY WARNING:
# DO NOT PUT SENSITIVE KEYS HERE (Notion API Key, Gemini Key, SMTP)!
# Frontend variables are public in the browser. All secret keys
# belong in .env.local (server-side only, no NEXT_PUBLIC_ prefix).
# See .env.backend.example for the required server-side keys.
# -------------------------------------------------------------
